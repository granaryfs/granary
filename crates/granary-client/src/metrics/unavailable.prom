# HELP granary_client_metrics_schema_version Catalogue schema version.
# TYPE granary_client_metrics_schema_version gauge
granary_client_metrics_schema_version 2
# HELP granary_client_metrics_incarnation Store incarnation as four unsigned 32-bit words.
# TYPE granary_client_metrics_incarnation gauge
granary_client_metrics_incarnation{word="0"} 66051
granary_client_metrics_incarnation{word="1"} 67438087
granary_client_metrics_incarnation{word="2"} 134810123
granary_client_metrics_incarnation{word="3"} 202182159
# HELP granary_client_metrics_available Producer wired and usable.
# TYPE granary_client_metrics_available gauge
granary_client_metrics_available{group="cache"} 0
granary_client_metrics_available{group="transport"} 0
granary_client_metrics_available{group="sync"} 0
granary_client_metrics_available{group="commit"} 0
granary_client_metrics_available{group="contention"} 0
granary_client_metrics_available{group="fuse"} 0
