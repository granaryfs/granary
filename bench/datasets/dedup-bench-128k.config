# dedup-bench configuration for scripts/bench/dedup-bench-crosscheck.sh's 128k mode.
# Uses min 128 KiB, avg 256 KiB, max 2 MiB and normalization level 1,
# matching granary_core::thresh::{MIN_GRAIN,AVG_GRAIN,MAX_GRAIN,NORMALIZATION_LEVEL}.
# The script reads these values from this file, not from Rust; nothing
# mechanical binds them to granary_core::thresh, so a change on either side
# must move the whole tuple.
# Matching only the floor while retaining avg 1 MiB and max 8 MiB would
# compare a chimera against granary's actual parameters: a parameter
# mismatch, not implementation agreement.
# The matched-population comparison's outcome is recorded in the
# `CdcRelevant` doc in crates/granary-bench/src/sweep.rs.
# The path is fixed per mode; the script takes no config argument or
# environment override.
#
# output_file MUST be hash.out — the script reads $work/hash.out and
# dedup.exe's own default is hashes.out (config.cpp:166).
# buffer_size MUST be >= fastcdc_max_block_size: chunking_common.cpp's
# chunk_stream caps a chunk at the stream buffer, so a smaller buffer
# silently truncates every large chunk at the buffer boundary.
chunking_algo=fastcdc
hashing_algo=xxhash128
output_file=hash.out
simd_mode=none

buffer_size=8388608

# FastCDC Parameters
fastcdc_min_block_size=131072
fastcdc_avg_block_size=262144
fastcdc_max_block_size=2097152
fastcdc_normalization_level=1
fastcdc_disable_normalization=false
