# dedup-bench configuration for scripts/bench/dedup-bench-crosscheck.sh's legacy mode.
# Uses min 512 KiB, avg 1 MiB, max 8 MiB and normalization level 1.
# The block sizes differ from granary_core::thresh's shipped tuple
# (min 128 KiB, avg 256 KiB, max 2 MiB); normalization level 1 is the same.
# The script reads its threshold from this file, not from Rust, so the
# legacy mode and granary select different file populations, and their
# realized distributions are not a matched-population comparison.
# The values are a frozen input to a completed measurement; changing them
# defines a different configuration, not an updated one. The script's 128k
# mode is the shipped-tuple comparison; see the `CdcRelevant` doc in
# crates/granary-bench/src/sweep.rs.
# The path is fixed per mode; the script takes no config argument or
# environment override.
#
# output_file MUST be hash.out — the script reads $work/hash.out and
# dedup.exe's own default is hashes.out (config.cpp:166).
# buffer_size MUST be >= fastcdc_max_block_size: chunking_common.cpp's
# chunk_stream caps a chunk at the stream buffer, so a smaller buffer
# silently truncates every large chunk at the buffer boundary.
chunking_algo=fastcdc
hashing_algo=xxhash128
output_file=hash.out
simd_mode=none

buffer_size=8388608

# FastCDC Parameters
fastcdc_min_block_size=524288
fastcdc_avg_block_size=1048576
fastcdc_max_block_size=8388608
fastcdc_normalization_level=1
fastcdc_disable_normalization=false
